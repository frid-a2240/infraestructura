# PostgreSQL (en el servidor: la contraseña del PostgreSQL DEL SERVIDOR)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infraestructura
DB_USER=postgres
DB_PASSWORD=

# JWT (en el servidor genera uno nuevo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# Notificaciones SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Los avisos de solicitudes nuevas y recordatorios llegan solos a todos los administradores
# activos (al correo de su cuenta). Aquí solo van correos EXTRA, separados por coma; puede ir vacío.
ADMIN_NOTIFY_EMAILS=

# URL con la que los usuarios abren el sistema (se usa en los links de los correos)
#   Laptop:   http://localhost:5173
#   Servidor: http://gacenssv03/infraestructura
FRONTEND_URL=http://localhost:5173

# Solo en la laptop. En el servidor NO se pone: IIS asigna el puerto desde web.config.
PORT=4010
